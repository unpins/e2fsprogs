Use a working scandir() for mke2fs -d <directory> under Cosmopolitan.

cosmo's scandir() returns garbage dirents and its readdir() leaves
d_reclen at 0 (d_name is right). Upstream's _WIN32 fallback copies d_reclen
bytes, so it fails the same way. This one is built on readdir() and copies
the whole fixed-size struct dirent. Defined after <dirent.h>, so only the
calls are rerouted, not the system declarations.

--- a/misc/create_inode.c
+++ b/misc/create_inode.c
@@ -935,6 +935,46 @@
 }
 #endif
 
+#ifdef __COSMOPOLITAN__
+static int e2fs_alphasort(const struct dirent **a, const struct dirent **b) {
+        return strcoll((*a)->d_name, (*b)->d_name);
+}
+static int e2fs_scandir(const char *dir_name, struct dirent ***name_list,
+                        int (*filter)(const struct dirent *),
+                        int (*compar)(const struct dirent **,
+                                      const struct dirent **)) {
+        DIR *dir;
+        struct dirent *dent, **list = NULL;
+        size_t cap = 0, n = 0;
+        dir = opendir(dir_name);
+        if (!dir) return -1;
+        while ((dent = readdir(dir))) {
+                if (filter && !(*filter)(dent)) continue;
+                if (n == cap) {
+                        size_t ncap = cap + 32;
+                        struct dirent **nl = realloc(list, ncap * sizeof(*nl));
+                        if (!nl) goto err;
+                        cap = ncap; list = nl;
+                }
+                list[n] = malloc(sizeof(struct dirent));
+                if (!list[n]) goto err;
+                memcpy(list[n], dent, sizeof(struct dirent));
+                n++;
+        }
+        closedir(dir);
+        if (compar) qsort(list, n, sizeof(*list),
+                          (int (*)(const void *, const void *))compar);
+        *name_list = list;
+        return (int)n;
+err:
+        closedir(dir);
+        while (n) free(list[--n]);
+        free(list);
+        return -1;
+}
+#define scandir e2fs_scandir
+#define alphasort e2fs_alphasort
+#endif
 /* Copy files from source_dir to fs in alphabetical order */
 static errcode_t __populate_fs(ext2_filsys fs, ext2_ino_t parent_ino,
 			       const char *source_dir, ext2_ino_t root,
