Rename the generated et_list variable off `link`.

et_c.awk emits `struct et_list link` into every *_err.c, and cosmocc's
libc declares POSIX link().

--- a/lib/et/et_c.awk
+++ b/lib/et/et_c.awk
@@ -238,7 +238,7 @@
 		tab_base_low, table_item_count) > outfile
 	}
 	print "" > outfile
-	print "static struct et_list link = { 0, 0 };" > outfile
+	print "static struct et_list et_link = { 0, 0 };" > outfile
 	print "" > outfile
 	print "void initialize_" table_name "_error_table_r(struct et_list **list);" > outfile
 	print "void initialize_" table_name "_error_table(void);" > outfile
@@ -257,8 +257,8 @@
 	print "            return;" > outfile
 	print "    et = malloc(sizeof(struct et_list));" > outfile
 	print "    if (et == 0) {" > outfile
-	print "        if (!link.table)" > outfile
-	print "            et = &link;" > outfile
+	print "        if (!et_link.table)" > outfile
+	print "            et = &et_link;" > outfile
 	print "        else" > outfile
 	print "            return;" > outfile
 	print "    }" > outfile
